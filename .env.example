APP_NAME=social-media-agent
APP_ENV=development
LOG_LEVEL=INFO

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_THINK=false

RESEARCH_QUERY_COUNT=2
SEARCH_RESULTS_PER_QUERY=3
RESEARCH_SNIPPET_MAX_CHARS=1200

YOUTUBE_TITLE_MAX_CHARS=100
YOUTUBE_DESCRIPTION_MAX_CHARS=5000
YOUTUBE_SCRIPT_TARGET_WORDS=600

INSTAGRAM_CAROUSEL_SLIDE_COUNT=7

X_POST_MAX_CHARS=280
X_THREAD_POST_COUNT=5

MAX_QUALITY_RETRIES=1

MAX_GROUNDING_RETRIES=1

DATABASE_URL=sqlite:///./data/database/social_media_agent.db
DATABASE_ECHO=false
YOUTUBE_THUMBNAIL_WIDTH=3840
YOUTUBE_THUMBNAIL_HEIGHT=2160

INSTAGRAM_ASSET_WIDTH=1080
INSTAGRAM_ASSET_HEIGHT=1350

INSTAGRAM_REEL_WIDTH=1080
INSTAGRAM_REEL_HEIGHT=1920

IMAGE_GENERATION_ENABLED=false
# disabled | development | openai
IMAGE_PROVIDER=disabled

GENERATED_ASSETS_DIR=data/output/generated_assets

IMAGE_GENERATION_TIMEOUT_SECONDS=300
IMAGE_SIZE_MULTIPLE=16

OPENAI_API_KEY=
OPENAI_IMAGE_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_OUTPUT_FORMAT=jpeg
OPENAI_IMAGE_BACKGROUND=opaque
OPENAI_IMAGE_OUTPUT_COMPRESSION=90

GROUNDING_TIMEOUT_SECONDS=300
GROUNDING_MAX_OUTPUT_TOKENS=900
GROUNDING_SOURCE_MAX_CHARS=800
GROUNDING_MAX_SOURCES=6
IDEA_TIMEOUT_SECONDS=300
IDEA_MAX_OUTPUT_TOKENS=1400

MASTER_CONTENT_TIMEOUT_SECONDS=300
MASTER_CONTENT_MAX_OUTPUT_TOKENS=1400

QUALITY_TIMEOUT_SECONDS=300
QUALITY_MAX_OUTPUT_TOKENS=900
CREATIVE_TIMEOUT_SECONDS=300
CREATIVE_MAX_OUTPUT_TOKENS=1200
CREATIVE_SOURCE_CONTEXT_MAX_CHARS=2500
CREATIVE_IMAGE_BRIEF_MAX_OUTPUT_TOKENS=700
CREATIVE_STORYBOARD_MAX_OUTPUT_TOKENS=900

INSTAGRAM_REEL_SCENE_COUNT=5

X_ASSET_WIDTH=1600
X_ASSET_HEIGHT=900
PLATFORM_GROUNDING_TIMEOUT_SECONDS=300
PLATFORM_GROUNDING_MAX_OUTPUT_TOKENS=800
MAX_PLATFORM_GROUNDING_RETRIES=1

PUBLISHING_MODE=dry_run
MEDIA_URL_PROVIDER=public_base_url
PUBLIC_MEDIA_BASE_URL=

MEDIA_S3_BUCKET=
MEDIA_S3_REGION=
MEDIA_S3_PREFIX=social-media-agent
MEDIA_S3_ENDPOINT_URL=
MEDIA_S3_PRESIGNED_URL_EXPIRY_SECONDS=3600

X_API_BASE_URL=https://api.x.com/2
X_USER_ACCESS_TOKEN=
X_REQUEST_TIMEOUT_SECONDS=60

INSTAGRAM_API_BASE_URL=https://graph.facebook.com
INSTAGRAM_API_VERSION=v26.0
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_REQUEST_TIMEOUT_SECONDS=60
INSTAGRAM_MAX_CAROUSEL_ITEMS=10
INSTAGRAM_CONTAINER_POLL_INTERVAL_SECONDS=2
INSTAGRAM_CONTAINER_MAX_POLL_ATTEMPTS=30
